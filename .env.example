# Supabase (required) — already mirrored in .env for Lovable Cloud
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional: service role for server-side writes that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# Express API
API_PORT=3001
VITE_API_URL=/api
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=http://127.0.0.1:3001

# Display FX rate (USD per 1 BDT). Default ~1/122
VITE_USD_PER_BDT=0.008196
NEXT_PUBLIC_USD_PER_BDT=0.008196
USD_PER_BDT=0.008196

# Jarvis Common Center webhook (optional)
JARVIS_WEBHOOK_URL=
JARVIS_API_KEY=

# --- Control plane (monitoring / FAOS server-to-server) ---
# Shared secret for /admin/* and /orders/:id endpoints. Send as `x-admin-key` header.
# Generate a strong random value (e.g. `openssl rand -hex 32`).
ADMIN_API_KEY=

# --- Server-side conversion tracking (all optional; inert until set) ---
# Public pixel IDs (safe to expose to browser via /tracking/config):
META_PIXEL_ID=
GA4_MEASUREMENT_ID=
TIKTOK_PIXEL_ID=
# Server-side secrets (NEVER expose to browser):
META_CAPI_TOKEN=
GA4_API_SECRET=
TIKTOK_ACCESS_TOKEN=

# --- Payments (international; inert until Stripe key present) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_CURRENCY=USD

# Next.js public mirrors of Supabase (for next-app/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
