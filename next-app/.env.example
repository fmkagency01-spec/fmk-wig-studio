# Vercel Production and Preview require a new build after changing NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=https://cxmkzzcgkvhfnqtmuxam.supabase.co
# Public anon/publishable key from fmk-wig-production, never a service-role key.
# This application reads PUBLISHABLE_KEY, not NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=https://fmk-wig-api.onrender.com
